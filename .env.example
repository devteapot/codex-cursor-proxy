# Generate a real value with: npm run init
PROXY_API_KEY=replace-with-a-long-random-secret

# The proxy binds to loopback. Put an authenticated HTTPS tunnel in front of it
# rather than binding the process directly to the public internet.
HOST=127.0.0.1
PORT=8787

# Optional overrides
# CODEX_AUTH_FILE=/absolute/path/to/auth.json
# CODEX_UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
# CODEX_CLIENT_VERSION=0.151.0
# CODEX_PROXY_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
# DEFAULT_REASONING_EFFORT=high
# MAX_CONCURRENT_REQUESTS=0
# MAX_REQUEST_BYTES=20971520
